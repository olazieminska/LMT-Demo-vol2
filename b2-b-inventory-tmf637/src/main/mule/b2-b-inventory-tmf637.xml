<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd ">
    <http:listener-config name="tmf637-telco-spec-httpListenerConfig">
        <http:listener-connection host="0.0.0.0" port="8081" />
    </http:listener-config>
    <apikit:config name="tmf637-telco-spec-config" api="resource::de727bf7-c1aa-485a-b0eb-0b60b6ad4dd3:tmf637-telco-spec:4.0.0:raml:zip:tmf637-telco-spec.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
    <flow name="tmf637-telco-spec-main">
        <http:listener config-ref="tmf637-telco-spec-httpListenerConfig" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="tmf637-telco-spec-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:BAD_REQUEST">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Bad request"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Method not allowed"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">405</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_ACCEPTABLE">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not acceptable"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">406</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Unsupported media type"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">415</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_IMPLEMENTED">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not Implemented"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">501</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="tmf637-telco-spec-console">
        <http:listener config-ref="tmf637-telco-spec-httpListenerConfig" path="/console/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="tmf637-telco-spec-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="get:\productInventory:tmf637-telco-spec-config">
        <set-variable variableName="offeringId" value="#[(attributes.queryParams.productOfferingId default 'OFFERING_DAAS_LAPTOP') as String]" />
        <set-variable variableName="warehouseLocationId" value="#[(attributes.queryParams.locationId default 'RIGA_DC') as String]" />
        <ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var warehouseLocationId = vars.warehouseLocationId default "RIGA_DC"
---
[
  {
    id: "INV-DAAS-001",
    href: "/productInventoryManagement/v4/productInventory/INV-DAAS-001",
    status: "available",
    productOffering: {
      id: vars.offeringId,
      name: "DaaS Laptop 36M"
    },
    resourceSerialNumber: "LAP-AX12345",
    quantity: 12,
    place: {
      id: warehouseLocationId,
      name: if (warehouseLocationId == "RIGA_DC") "Riga Distribution Center" else "Warehouse " ++ warehouseLocationId
    },
    lastUpdate: now() as String,
    warehouseIntegration: {
      sourceSystem: "EXT_WAREHOUSE_WMS",
      sourceType: "linked-external-system",
      sourceReference: "WMS-STOCK-" ++ warehouseLocationId ++ "-" ++ (vars.offeringId as String),
      syncedAt: now() as String
    }
  }
] as Array {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
    <flow name="post:logisticsEvent-ingest">
        <http:listener config-ref="tmf637-telco-spec-httpListenerConfig" path="/api/logisticsEvent">
            <http:response statusCode="#[vars.httpStatus default 202]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <set-variable variableName="logisticsEventRequest" value="#[payload]" />
        <set-variable variableName="logisticsEventType" value="#[(vars.logisticsEventRequest.eventType default vars.logisticsEventRequest.state default 'shipped') as String]" />
        <set-variable variableName="httpStatus" value="202" />
        <logger level="INFO" message='#["logistics.event.ingested=" ++ write(vars.logisticsEventRequest, "application/json")]' />
        <ee:transform doc:name="Build Logistics Event Acknowledgement">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var eventType = lower(vars.logisticsEventType as String)
var normalizedEventType = if (eventType == "shipped" or eventType == "delivered" or eventType == "returned") eventType else "shipped"
---
{
  status: "ACCEPTED",
  eventType: normalizedEventType,
  processedAt: now() as String,
  orderId: vars.logisticsEventRequest.orderId default "ORD-B2B-UNKNOWN",
  inventoryId: vars.logisticsEventRequest.inventoryId default "INV-DAAS-001",
  trackingNumber: vars.logisticsEventRequest.trackingNumber default "TRK-N/A",
  platformAction: if (normalizedEventType == "returned") "INITIATE_BILLING_ADJUSTMENT" else "UPDATE_FULFILMENT_MILESTONE",
  billingAdjustmentTrigger: normalizedEventType == "returned",
  note: "Warehouse logistics event processed by TMF637 integration endpoint."
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
</mule>
