#%RAML 1.0
title: TMF637 Product Inventory Management Process API
version: v4
baseUri: https://api.lmt.lv/papi/productInventoryManagement/v4
mediaType: application/json

documentation:
  - title: Overview
    content: |
      Process API implementing TMF637 Product Inventory Management.
      Provides the self-care subscription view for an authenticated customer.
      Returns active plan, eSIM status, assigned MSISDN and plan allowances.
      Data isolation rule: requests are strictly scoped to the requesting customerId.
      Any request for a customerId that does not match returns 403 — a customer
      can never see another customer's data.
      SIMULATION NOTE: This PAPI composes the response from known demo values
      (customerId CUST-DB-99812). No GET endpoint exists on the underlying System
      APIs at this stage — this is clearly identified as a simulation per the
      demonstration rules in Appendix 9 Section 1.

/product:
  get:
    displayName: Get Product Inventory (Self-Care View)
    description: |
      Returns the active subscription and product inventory for a customer.
      Query parameter customerId is mandatory and must match the authenticated
      session (enforced for data isolation compliance).
      Returns plan details, eSIM activation status, assigned MSISDN and allowances.
    queryParameters:
      customerId:
        type: string
        required: true
        description: The customerId of the requesting customer. Must match authenticated session.
        example: "CUST-DB-99812"
    responses:
      200:
        description: Active product inventory returned for the customer
        body:
          application/json:
            example:
              - id: "PROD-INV-99812"
                href: "/productInventoryManagement/v4/product/PROD-INV-99812"
                status: "active"
                name: "Switzerland Connect Plan"
                startDate: "2026-08-05T10:02:30Z"
                relatedParty:
                  - id: "CUST-DB-99812"
                    role: "customer"
                billingAccount:
                  id: "BAC-DB-99812"
                  paymentMethod: "CreditCard"
                productOffering:
                  id: "OFFERING_SWISS_CONNECT"
                  name: "Switzerland Connect Plan"
                productSerialNumber: "8937100000000012345"
                realizingService:
                  - id: "SVC-ESIM-99812"
                    type: "eSIM"
                    iccid: "8937100000000012345"
                    msisdn: "+37120001234"
                    smdpAddress: "smdp.lmt.lv"
                    activationCode: "LPA:1$smdp.lmt.lv$CONF-CODE-99812"
                    esimStatus: "RELEASED"
                productCharacteristic:
                  - name: "latviaData"
                    value: "UNLIMITED"
                  - name: "latviaVoiceSms"
                    value: "UNLIMITED"
                  - name: "switzerlandVoiceMins"
                    value: "60"
                price:
                  amount: 19.99
                  currency: "EUR"
                  billingPeriod: "Monthly"
      400:
        description: Missing mandatory customerId query parameter
        body:
          application/json:
            example:
              code: "400"
              reason: "MISSING_CUSTOMER_ID"
              message: "Query parameter customerId is required."
              status: "400"
      403:
        description: Data isolation violation — requested customerId does not match session
        body:
          application/json:
            example:
              code: "403"
              reason: "ACCESS_DENIED"
              message: "You are not authorised to view account information for this customer."
              status: "403"
      404:
        description: No active products found for this customer
        body:
          application/json:
            example:
              code: "404"
              reason: "NO_ACTIVE_PRODUCTS"
              message: "No active product subscriptions found for customer CUST-DB-99812."
              status: "404"
