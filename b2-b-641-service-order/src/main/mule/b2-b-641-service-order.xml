    <flow name="post:\serviceOrder:application\json:tmf-641-serviceorder-v4-oas-config">
        <set-variable variableName="serviceOrderId" value="#[&quot;SO-&quot; ++ (uuid() as String)[0 to 7] ++ &quot;-&quot; ++ (now() as String {format: &quot;yyyyMMddHHmmss&quot;})]" />
        <ee:transform doc:name="Build TMF641 ServiceOrder Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var incoming = payload default {}
var generatedId = vars.serviceOrderId
var baseHref = "http://localhost:8081/api/serviceOrder/"
var orderItems = (incoming.serviceOrderItem default []) map ((item, index) -> (item - "id" - "state") ++ {
    id: (item.id default ((index + 1) as String)),
    state: (item.state default "acknowledged")
})
---
{
    id: generatedId,
    href: baseHref ++ generatedId,
    externalId: incoming.externalId default ("EXT-" ++ generatedId),
    category: incoming.category default "Managed Connectivity + DaaS",
    description: incoming.description default "Managed Connectivity + Device-as-a-Service bundle activation",
    orderDate: (now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}),
    requestedStartDate: incoming.requestedStartDate default (now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}),
    requestedCompletionDate: incoming.requestedCompletionDate default ((now() + |P2D|) as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}),
    state: "acknowledged",
    relatedParty: incoming.relatedParty default [
        {
            role: "customer",
            name: "Demo B2B Enterprise",
            "@referredType": "Organization"
        }
    ],
    serviceOrderItem: orderItems
}
]]></ee:set-payload>
            </ee:message>
            <ee:variables>
                <ee:set-variable variableName="httpStatus">201</ee:set-variable>
            </ee:variables>
        </ee:transform>
        <set-variable variableName="outboundHeaders" value='#[{
            "Content-Type": "application/json;charset=utf-8",
            "Location": "/api/serviceOrder/" ++ vars.serviceOrderId
        }]' />
        <ee:transform doc:name="Build Webhook Event Payload">
            <ee:variables>
                <ee:set-variable variableName="serviceOrderEventPayload"><![CDATA[%dw 2.0
output application/json
---
{
  eventId: uuid(),
  eventType: "ServiceOrderCreateEvent",
  eventTime: now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"},
  event: {
    serviceOrder: payload
  }
}
]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <async>
            <flow-ref name="notify-service-order-created-webhook" />
        </async>
        <logger level="INFO" message="TMF641 POST /serviceOrder created successfully" />
    </flow>
    <flow name="notify-service-order-created-webhook">
        <try>
            <set-payload value="#[vars.serviceOrderEventPayload]" />
            <http:request config-ref="webhookSiteRequestConfig" method="POST" path="/8d384e80-b0a8-4843-8c43-d00f32bbc44a">
                <http:headers><![CDATA[#[{
                    "Content-Type": "application/json"
                }]]]></http:headers>
            </http:request>
            <logger level="INFO" message='#[(&quot;ServiceOrderCreateEvent sent to webhook.site for id=&quot; ++ ((vars.serviceOrderId default &quot;unknown&quot;) as String)) as String]' />
            <error-handler>
                <on-error-continue type="ANY" logException="true">
                    <logger level="WARN" message='#[(&quot;Webhook notification failed for serviceOrderId=&quot; ++ ((vars.serviceOrderId default &quot;unknown&quot;) as String) ++ &quot; cause=&quot; ++ ((error.description default &quot;n/a&quot;) as String)) as String]' />
                </on-error-continue>
            </error-handler>
        </try>
    </flow>
