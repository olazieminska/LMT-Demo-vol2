    <apikit:config name="tmf622-aria-spec-config" api="resource::de727bf7-c1aa-485a-b0eb-0b60b6ad4dd3:tmf622-aria-spec:4.0.0:raml:zip:tmf622-aria-spec.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
    <flow name="tmf622-aria-spec-main">
        <http:listener config-ref="tmf622-aria-spec-httpListenerConfig" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
