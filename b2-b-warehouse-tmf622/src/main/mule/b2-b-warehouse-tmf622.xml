    <flow name="patch:\productOrder\(id):application\json:tmf622-aria-spec-config">
        <ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="id">attributes.uriParams.'id'</ee:set-variable>
            </ee:variables>
        </ee:transform>
        <set-variable variableName="patchRequest" value="#[payload]" />
        <set-variable variableName="targetState" value="#[(vars.patchRequest.state default 'inProgress') as String]" />
        <set-variable variableName="httpStatus" value="200" />
        <try doc:name="Update order state in order-sapi">
            <ee:transform doc:name="Map Order Status Patch Request">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  status: upper(vars.targetState)
}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
            <http:request method="PATCH" config-ref="order-sapi-request-config" path="#['/api/orders/' ++ vars.id ++ '/status']">
                <http:headers><![CDATA[#[{"Content-Type": "application/json"}]]]></http:headers>
            </http:request>
            <set-variable variableName="orderStatusPatchResponse" value="#[payload]" />
            <error-handler>
                <on-error-continue type="ANY">
                    <logger level="WARN" message="order-sapi PATCH failed, fallback to local simulated state update." />
                    <set-variable variableName="orderStatusPatchResponse" value='#[output application/java --- {orderId: vars.id, updatedStatus: upper(vars.targetState), source: "FALLBACK_SIMULATION"}]' />
                </on-error-continue>
            </error-handler>
        </try>
        <ee:transform doc:name="Build ProductOrderStateChangeEvent Payload">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var orderId = (vars.id default "ORD-B2B-UNKNOWN") as String
---
{
  eventId: "EVT-" ++ (now() as String {format: "yyyyMMddHHmmss"}),
  eventTime: now() as String,
  eventType: "ProductOrderStateChangeEvent",
  correlationId: "CORR-" ++ orderId,
  domain: "ProductOrdering",
  title: "Product order state changed",
  description: "Order " ++ orderId ++ " moved to state " ++ vars.targetState,
  priority: "normal",
  event: {
    productOrder: {
      id: orderId,
      href: "/tmf-api/productOrderingManagement/v4/productOrder/" ++ orderId,
      state: vars.targetState
    }
  }
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <set-variable variableName="stateChangeEvent" value="#[payload]" />
        <logger level="INFO" message='#["webhook.productOrderStateChangeEvent=" ++ write(vars.stateChangeEvent, "application/json")]' />
        <set-variable variableName="registeredWebhookCallback" value="#[(vars.patchRequest.callback default attributes.headers.'x-webhook-callback' default 'http://localhost:8081/api/listener/productOrderStateChangeEvent') as String]" />
        <set-variable variableName="webhookDeliveryStatus" value="NOT_REGISTERED" />
        <try doc:name="Push event to callback URL">
            <http:request method="POST" config-ref="order-sapi-request-config" url="#[vars.registeredWebhookCallback]">
                <http:headers><![CDATA[#[{"Content-Type": "application/json"}]]]></http:headers>
            </http:request>
            <set-variable variableName="webhookDeliveryStatus" value="DELIVERED" />
            <error-handler>
                <on-error-continue type="ANY">
                    <set-variable variableName="webhookDeliveryStatus" value="DELIVERY_FAILED" />
                    <logger level="WARN" message='#["Webhook dispatch failed for callback=" ++ (vars.registeredWebhookCallback default "N/A")]' />
                </on-error-continue>
            </error-handler>
        </try>
        <ee:transform doc:name="Build Patch Product Order Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var orderId = (vars.id default "ORD-B2B-UNKNOWN") as String
---
{
  id: orderId,
  href: "/tmf-api/productOrderingManagement/v4/productOrder/" ++ orderId,
  state: vars.targetState,
  productOrderItem: [
    {
      id: "1",
      state: vars.targetState
    }
  ],
  notificationEvent: vars.stateChangeEvent,
  webhookDelivery: {
    status: vars.webhookDeliveryStatus default "NOT_REGISTERED",
    endpoint: vars.registeredWebhookCallback default "/listener/productOrderStateChangeEvent"
  }
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
