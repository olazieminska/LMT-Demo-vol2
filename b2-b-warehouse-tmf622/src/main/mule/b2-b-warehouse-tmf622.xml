        <logger level="INFO" message='#["listener.productOrderStateChangeEvent.received=" ++ write(vars.receivedEvent, "application/json")]' />
        <ee:transform doc:name="Build Listener Acknowledgement Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  status: "RECEIVED",
  eventType: vars.receivedEvent.eventType default "ProductOrderStateChangeEvent",
  eventId: vars.receivedEvent.eventId default "N/A",
  receivedAt: now() as String
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
