    <flow name="post:\hub:application\json:tmf622-aria-spec-config">
        <set-variable variableName="hubRequest" value="#[payload]" />
        <set-variable variableName="subscriptionId" value="#['SUB-' ++ (now() as String {format: 'yyyyMMddHHmmss'})]" />
        <set-variable variableName="registeredCallback" value="#[(vars.hubRequest.callback default 'http://localhost:8081/api/listener/productOrderStateChangeEvent') as String]" />
        <set-variable variableName="httpStatus" value="201" />
        <ee:transform doc:name="Build Hub Registration Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  id: vars.subscriptionId,
  callback: vars.registeredCallback,
  query: vars.hubRequest.query default "eventType=ProductOrderStateChangeEvent"
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
    <flow name="post:\productOrder:application\json:tmf622-aria-spec-config">
        <set-variable variableName="orderRequest" value="#[payload]" />
        <set-variable variableName="orderId" value="#['ORD-B2B-' ++ (now() as String {format: 'yyyyMMddHHmmss'})]" />
        <set-variable variableName="httpStatus" value="201" />
        <logger level="INFO" message='#["productOrder.create request=" ++ write(vars.orderRequest, "application/json")]' />
        <set-variable variableName="requestedOfferingId" value="#[(vars.orderRequest.productOrderItem[0].productOffering.id default 'OFFERING_DAAS_LAPTOP') as String]" />
        <try doc:name="Validate offering in product-catalog-sapi">
            <http:request method="GET" config-ref="catalog-sapi-request-config" path="#['/api/offerings/' ++ vars.requestedOfferingId]" />
            <set-variable variableName="catalogResponse" value="#[payload]" />
            <error-handler>
                <on-error-continue type="ANY">
                    <logger level="WARN" message="product-catalog-sapi GET failed, fallback to local offering." />
                    <set-variable variableName="catalogResponse" value="#[{offeringId: vars.requestedOfferingId, name: 'DaaS Laptop 36M', source: 'FALLBACK_SIMULATION'}]" />
                </on-error-continue>
            </error-handler>
        </try>
        <try doc:name="Create order record in order-sapi">
            <ee:transform doc:name="Map Order Create Request">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  customerId: (vars.orderRequest.relatedParty[0].id default "ALPHACONSULT-SIA") as String,
  billingAccountId: (vars.orderRequest.billingAccount.id default "BAC-B2B-1001") as String,
  offeringId: vars.requestedOfferingId,
  amount: 49.99,
  currency: "EUR",
  state: "PENDING_FULFILMENT"
}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
            <http:request method="POST" config-ref="order-sapi-request-config" path="/api/orders">
                <http:headers><![CDATA[#[{"Content-Type": "application/json"}]]]></http:headers>
            </http:request>
            <set-variable variableName="orderSapiResponse" value="#[payload]" />
            <error-handler>
                <on-error-continue type="ANY">
                    <logger level="WARN" message="order-sapi POST failed, fallback to local order id." />
                    <set-variable variableName="orderSapiResponse" value="#[{orderId: vars.orderId, status: 'PENDING_FULFILMENT', source: 'FALLBACK_SIMULATION'}]" />
                </on-error-continue>
            </error-handler>
        </try>
        <ee:transform doc:name="Build Product Order Created Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var req = vars.orderRequest default {}
var orderItems = (req.productOrderItem default []) map ((item, index) -> {
  id: item.id default ((index + 1) as String),
  action: item.action default "add",
  quantity: item.quantity default 1,
  state: "acknowledged",
  productOffering: item.productOffering default {
    id: "OFFERING_DAAS_LAPTOP",
    name: "DaaS Laptop 36M"
  },
  product: item.product default {
    name: "DaaS Laptop Device"
  }
})
---
{
  id: vars.orderId,
  href: "/tmf-api/productOrderingManagement/v4/productOrder/" ++ vars.orderId,
  externalId: req.externalId default vars.orderId,
  description: req.description default "B2B DaaS laptop order",
  category: req.category default "enterprise",
  orderDate: now() as String,
  state: "acknowledged",
  relatedParty: req.relatedParty default [
    {
      id: "ALPHACONSULT-SIA",
      role: "customer",
      name: "AlphaConsult SIA"
    }
  ],
  billingAccount: req.billingAccount default {
    id: "BAC-B2B-1001",
    name: "AlphaConsult Billing Account"
  },
  productOrderItem: if (isEmpty(orderItems))
    [
      {
        id: "1",
        action: "add",
        quantity: 1,
        state: "acknowledged",
        productOffering: {
          id: "OFFERING_DAAS_LAPTOP",
          name: "DaaS Laptop 36M"
        },
        product: {
          name: "DaaS Laptop Device"
        }
      }
    ]
  else
    orderItems,
  downstreamIntegration: {
    catalog: {
      offeringId: vars.catalogResponse.offeringId default vars.requestedOfferingId,
      name: vars.catalogResponse.name default "DaaS Laptop 36M"
    },
    orderSapi: {
      orderId: vars.orderSapiResponse.orderId default vars.orderId,
      status: vars.orderSapiResponse.status default "PENDING_FULFILMENT"
    }
  }
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
