            <ee:variables>
                <ee:set-variable variableName="id">attributes.uriParams.'id'</ee:set-variable>
            </ee:variables>
        </ee:transform>
        <ee:transform doc:name="Build Get Product Order Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var orderId = (vars.id default "ORD-B2B-UNKNOWN") as String
---
{
  id: orderId,
  href: "/tmf-api/productOrderingManagement/v4/productOrder/" ++ orderId,
  externalId: orderId,
  state: "completed",
  category: "enterprise",
  productOrderItem: [
    {
      id: "1",
      action: "add",
      quantity: 1,
      state: "completed",
      productOffering: {
        id: "OFFERING_DAAS_LAPTOP",
        name: "DaaS Laptop 36M"
      }
    }
  ]
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
